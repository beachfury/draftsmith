{
  "schemaVersion": 1,
  "id": "draftsmith",
  "version": "${version}",
  "name": "DraftSmith",
  "description": "Lightweight server-side building editor for Fabric: GUI shapes, paint brushes, measuring tools, clipboard and undo. Crossplay-ready (Geyser/Bedrock) — no client mod required.",
  "authors": ["BeachFury"],
  "license": "MIT",
  "contact": {
    "sources": "https://github.com/beachfury/draftsmith",
    "issues": "https://github.com/beachfury/draftsmith/issues"
  },
  "icon": "assets/draftsmith/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.draftsmith.DraftSmith"]
  },
  "mixins": ["draftsmith.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "sgui": "*"
  },
  "suggests": {
    "fabric-permissions-api-v0": "*"
  }
}
